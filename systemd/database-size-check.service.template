[Unit]
Description=FileStow database size monitor
After=network-online.target
Wants=network-online.target
OnFailure=filestow-notify@%n.service

[Service]
Type=forking
__USER_GROUP_DIRECTIVES__
Environment=FILESTOW_CONFIG_DIR=__CONFIG_DIR__
RuntimeDirectory=filestow
# /run/filestow is shared (the GUI's control socket lives there too): keep it
# when this unit stops, or systemd deletes the socket file under the listener.
RuntimeDirectoryPreserve=yes
PIDFile=%t/filestow/database-size-check.pid
ExecStart=__INSTALL_DIR__/bin/systemd-fork-run.sh %t/filestow/database-size-check.pid /usr/bin/flock -n __LOCK_FILE__ __INSTALL_DIR__/bin/database-size-check.sh
SuccessExitStatus=SIGTERM
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup-db-monitor
MemoryAccounting=true
MemorySwapMax=64M
