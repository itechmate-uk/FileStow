#!/usr/bin/env bash
# Installs and runs the FileStow GUI as a systemd user unit of the login that
# administers FileStow (no sudo), like agentw-gui.
#
#   filestow-gui-server install     copy the GUI to ~/.local/share/filestow-gui/app,
#                                       write and start the user units (run again to update)
#   filestow-gui-server rollback    go back to the GUI installed before the last install
#   filestow-gui-server uninstall   stop and remove the user units (keeps settings)
#   sudo filestow-gui-server install --system
#                                       one GUI for the whole server instead: a system unit
#                                       run by the account filestow-gui, its socket
#                                       /run/filestow-gui/gui.sock open to the group
#                                       filestow-gui (the GUI admins)
#   sudo filestow-gui-server uninstall --system
#   filestow-gui-server start|stop|restart
#   filestow-gui-server status [--backend user@host]
#                                       unit state, the GUI watchdog, and every way to
#                                       connect; saves the Tunnel Manager profile and the
#                                       launchers in ~/.local/share/filestow-gui/client-launchers
#   filestow-gui-server bundle [--backend user@host]
#                                       print the Tunnel Manager profile (first import)
#   filestow-gui-server backend user@host
#                                       save the user@host of your Tunnel Manager profile,
#                                       used by the profile, the launchers and the GUI
#   filestow-gui-server service-run run the server in the foreground (debugging)

set -euo pipefail

INSTANCE=4337
UNIT="filestow-gui-$INSTANCE.service"
WATCHDOG_UNIT="filestow-gui-watchdog-$INSTANCE.service"
SOURCE_GUI_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APP_DIR="$DATA_HOME/filestow-gui/app"
UNIT_DIR="$CONFIG_HOME/systemd/user"
NODE_MIN_MAJOR=18
SYSTEM_ROOT=/usr/local/lib/filestow-gui
SYSTEM_UNIT=filestow-gui.service
SYSTEM_USER=filestow-gui
SYSTEM_GROUP=filestow-gui
SYSTEM_STATE=/var/lib/filestow-gui

usage() {
  sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'filestow-gui-server: %s\n' "$*" >&2
  exit 1
}

node_major() {
  "$1" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || printf '0'
}

# The absolute path of a Node >= 18: FILESTOW_GUI_NODE, /usr/bin/node, then PATH.
find_node() {
  local candidate
  for candidate in "${FILESTOW_GUI_NODE:-}" /usr/bin/node /usr/local/bin/node "$(command -v node 2>/dev/null || true)"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    if [ "$(node_major "$candidate")" -ge "$NODE_MIN_MAJOR" ]; then
      readlink -f "$candidate"
      return 0
    fi
  done
  return 1
}

settings_value() {
  # settings_value <node> <app-dir> <expression on the normalized settings>
  "$1" -e 'const s = require(process.argv[1] + "/lib/settings").load(); process.stdout.write(String(eval(process.argv[2])));' "$2" "$3"
}

render() {
  local template="$1" output="$2" node="$3"
  local memory_high memory_max tasks_max
  memory_high=$(settings_value "$node" "$APP_DIR" 's.limits.memoryHighMb')
  memory_max=$(settings_value "$node" "$APP_DIR" 's.limits.memoryMaxMb')
  tasks_max=$(settings_value "$node" "$APP_DIR" 's.limits.tasksMax')
  sed \
    -e "s|__INSTANCE__|$INSTANCE|g" \
    -e "s|__GUI_DIR__|$APP_DIR|g" \
    -e "s|__NODE__|$node|g" \
    -e "s|__MEMORY_HIGH__|$memory_high|g" \
    -e "s|__MEMORY_MAX__|$memory_max|g" \
    -e "s|__TASKS_MAX__|$tasks_max|g" \
    "$template" > "$output.tmp"
  if grep -Eq '__[A-Z_]+__' "$output.tmp"; then
    rm -f "$output.tmp"
    die "Unresolved placeholder in $(basename "$output")"
  fi
  mv -f "$output.tmp" "$output"
}

# Copies the GUI to $APP_DIR; the copy it replaces stays as $APP_DIR.previous for
# rollback. The updater (bin/filestow-update.py in a release or checkout) goes
# into scripts/, so the GUI can update itself.
copy_app() {
  local staging="$APP_DIR.new"
  rm -rf "$staging"
  mkdir -p "$staging"
  cp -a "$SOURCE_GUI_DIR/server.js" "$SOURCE_GUI_DIR/package.json" "$SOURCE_GUI_DIR/lib" "$SOURCE_GUI_DIR/public" \
    "$SOURCE_GUI_DIR/scripts" "$SOURCE_GUI_DIR/systemd" "$staging/"
  if [ -f "$SOURCE_GUI_DIR/../bin/filestow-update.py" ]; then
    install -m 755 "$SOURCE_GUI_DIR/../bin/filestow-update.py" "$staging/scripts/filestow-update.py"
  fi
  chmod -R go-w "$staging"
  rm -rf "$APP_DIR.previous"
  [ -d "$APP_DIR" ] && mv "$APP_DIR" "$APP_DIR.previous"
  mv "$staging" "$APP_DIR"
}

install_gui() {
  local node linger socket_path
  [ "$(id -u)" -ne 0 ] || die "Install the GUI as the login that administers FileStow, not as root."
  node=$(find_node) || die "Node.js $NODE_MIN_MAJOR or newer is required (set FILESTOW_GUI_NODE to its path)."
  mkdir -p "$DATA_HOME/filestow-gui" "$UNIT_DIR" "$CONFIG_HOME/filestow-gui"
  chmod 700 "$DATA_HOME/filestow-gui" "$CONFIG_HOME/filestow-gui"
  copy_app
  render "$APP_DIR/systemd/filestow-gui.service.template" "$UNIT_DIR/$UNIT" "$node"
  render "$APP_DIR/systemd/filestow-gui-watchdog.service.template" "$UNIT_DIR/$WATCHDOG_UNIT" "$node"
  {
    printf 'GUI_MEMORY_STOP_MB=%s\n' "$(settings_value "$node" "$APP_DIR" 's.limits.watchdogMemoryMb')"
    printf 'GUI_TASKS_STOP=%s\n' "$(settings_value "$node" "$APP_DIR" 's.limits.watchdogTasks')"
  } > "$CONFIG_HOME/filestow-gui/watchdog.env"
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" "$WATCHDOG_UNIT" >/dev/null
  systemctl --user restart "$UNIT"
  systemctl --user start "$WATCHDOG_UNIT" || true
  sleep 1
  socket_path=$("$node" -e 'const l = require(process.argv[1] + "/lib/listen-config"); const s = require(process.argv[1] + "/lib/settings").load(); process.stdout.write(l.resolveListen({ settings: s }).socketPath)' "$APP_DIR")
  linger=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || echo unknown)
  echo "Installed $UNIT (Node $node, app $APP_DIR)."
  echo "State: $(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
  echo "Socket: $socket_path"
  if [ "$linger" != "yes" ]; then
    echo "Linger is '$linger': the GUI stops when you log out. Run once: loginctl enable-linger $(id -un)"
  else
    echo "Linger is on: the GUI keeps running with nobody logged in."
  fi
  echo "Ways to connect (Tunnel Manager profile, launchers, phone, manual): $0 status"
  echo "Set the user@host of your Tunnel Manager profile first if it differs: $0 backend $(id -un)@<this server as in that profile>"
}

rollback_gui() {
  [ -d "$APP_DIR.previous" ] || die "There is no previous GUI in $APP_DIR.previous."
  rm -rf "$APP_DIR.failed"
  mv "$APP_DIR" "$APP_DIR.failed"
  mv "$APP_DIR.previous" "$APP_DIR"
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  systemctl --user restart "$UNIT"
  echo "Back to the previous GUI ($(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$APP_DIR/package.json")); the failed one is in $APP_DIR.failed."
}

# ------------------------------------------------------------ system-wide GUI

install_system_gui() {
  local node
  [ "$(id -u)" -eq 0 ] || die "install --system needs root (sudo)."
  node=$(find_node) || die "Node.js $NODE_MIN_MAJOR or newer is required (set FILESTOW_GUI_NODE to its path)."
  if ! getent group "$SYSTEM_GROUP" >/dev/null; then
    groupadd --system "$SYSTEM_GROUP"
  fi
  if ! getent passwd "$SYSTEM_USER" >/dev/null; then
    useradd --system --gid "$SYSTEM_GROUP" --no-create-home --home-dir "$SYSTEM_STATE" --shell /usr/sbin/nologin \
      --comment "FileStow GUI" "$SYSTEM_USER"
  fi
  # A copy owned by root that the service account can read but not change.
  install -d -m 755 "$SYSTEM_ROOT"
  APP_DIR="$SYSTEM_ROOT/app"
  copy_app
  chown -R root:root "$SYSTEM_ROOT"
  chmod -R a+rX,go-w "$APP_DIR"
  sed \
    -e "s|__GUI_DIR__|$APP_DIR|g" \
    -e "s|__NODE__|$node|g" \
    -e "s|__USER__|$SYSTEM_USER|g" \
    -e "s|__GROUP__|$SYSTEM_GROUP|g" \
    -e "s|__MEMORY_HIGH__|128|g" \
    -e "s|__MEMORY_MAX__|192|g" \
    -e "s|__TASKS_MAX__|64|g" \
    "$APP_DIR/systemd/filestow-gui-system.service.template" > "/etc/systemd/system/$SYSTEM_UNIT.tmp"
  if grep -Eq '__[A-Z_]+__' "/etc/systemd/system/$SYSTEM_UNIT.tmp"; then
    rm -f "/etc/systemd/system/$SYSTEM_UNIT.tmp"
    die "Unresolved placeholder in $SYSTEM_UNIT"
  fi
  chmod 644 "/etc/systemd/system/$SYSTEM_UNIT.tmp"
  mv -f "/etc/systemd/system/$SYSTEM_UNIT.tmp" "/etc/systemd/system/$SYSTEM_UNIT"
  systemctl daemon-reload
  systemctl enable "$SYSTEM_UNIT" >/dev/null
  systemctl reset-failed "$SYSTEM_UNIT" >/dev/null 2>&1 || true
  systemctl restart "$SYSTEM_UNIT"
  sleep 2
  echo "Installed $SYSTEM_UNIT (Node $node, app $APP_DIR), run by $SYSTEM_USER."
  echo "State: $(systemctl is-active "$SYSTEM_UNIT" 2>/dev/null || true)"
  echo "Socket: /run/filestow-gui/gui.sock, for the members of $SYSTEM_GROUP: $(getent group "$SYSTEM_GROUP" | cut -d: -f4)"
  echo "Add an admin: sudo usermod -a -G $SYSTEM_GROUP <login> (then that login logs in again)."
}

uninstall_system_gui() {
  [ "$(id -u)" -eq 0 ] || die "uninstall --system needs root (sudo)."
  systemctl disable --now "$SYSTEM_UNIT" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/$SYSTEM_UNIT"
  systemctl daemon-reload
  echo "Removed $SYSTEM_UNIT. Its settings stay in $SYSTEM_STATE and the app in $SYSTEM_ROOT; the account $SYSTEM_USER is kept."
}

system_flag() {
  [ "${1:-}" = "--system" ]
}

uninstall_gui() {
  systemctl --user disable --now "$WATCHDOG_UNIT" "$UNIT" >/dev/null 2>&1 || true
  rm -f "$UNIT_DIR/$UNIT" "$UNIT_DIR/$WATCHDOG_UNIT"
  systemctl --user daemon-reload
  echo "Removed $UNIT. Settings stay in $CONFIG_HOME/filestow-gui; the app copy in $APP_DIR."
}

LAUNCHER_DIR="$DATA_HOME/filestow-gui/client-launchers"

# connect_cli <command> [args...]: the GUI's own connection code (scripts/connect-cli.js),
# from the installed copy when there is one.
connect_cli() {
  local node app_dir="$APP_DIR"
  node=$(find_node) || die "Node.js $NODE_MIN_MAJOR or newer is required."
  [ -f "$app_dir/scripts/connect-cli.js" ] || app_dir="$SOURCE_GUI_DIR"
  "$node" "$app_dir/scripts/connect-cli.js" "$app_dir" "$@"
}

backend_option() {
  # Prints the value of --backend from the arguments, or nothing.
  local backend=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --backend) backend="${2:?--backend needs user@host}"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  printf '%s' "$backend"
}

print_status() {
  local backend state
  backend=$(backend_option "$@")
  state=$(systemctl --user is-active "$UNIT" 2>/dev/null || true)
  echo "$UNIT: ${state:-unknown}"
  if [ "$state" = "active" ]; then
    echo "Service pid: $(systemctl --user show -p MainPID --value "$UNIT")"
  else
    echo "Start it with: filestow-gui-server start (Tunnel Manager also starts it when it connects)."
  fi
  echo "Service logs: journalctl --user -u $UNIT -f"
  "$SOURCE_GUI_DIR/scripts/filestow-gui-watchdog" status || true
  echo
  connect_cli status "$LAUNCHER_DIR" $backend
}

case "${1:-}" in
  install)
    if system_flag "${2:-}"; then install_system_gui; else install_gui; fi
    ;;
  uninstall)
    if system_flag "${2:-}"; then uninstall_system_gui; else uninstall_gui; fi
    ;;
  rollback) rollback_gui ;;
  start|stop|restart) systemctl --user "$1" "$UNIT" ;;
  status) shift; print_status "$@" ;;
  bundle) shift; connect_cli bundle $(backend_option "$@") ;;
  backend)
    [ -n "${2:-}" ] || die "Usage: filestow-gui-server backend user@host"
    connect_cli save-backend "$2"
    ;;
  service-run)
    node=$(find_node) || die "Node.js $NODE_MIN_MAJOR or newer is required."
    exec "$node" "$SOURCE_GUI_DIR/server.js"
    ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 64 ;;
esac
